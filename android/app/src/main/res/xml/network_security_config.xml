<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Produksi wajib lewat HTTPS. Pengecualian cleartext hanya untuk alamat
        pengembangan lokal, supaya APK rilis tidak pernah bisa berbicara ke
        server tanpa enkripsi.
    -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 10.0.2.2 adalah alamat komputer host dilihat dari emulator Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- IP laptop di jaringan lokal, untuk uji dengan HP asli. Daftarnya
             tumbuh karena Android tidak menerima wildcard atau CIDR di sini,
             dan IP laptop berganti tiap pindah jaringan. IP lama dibiarkan
             supaya APK lama tidak mendadak mati saat kembali ke kantor. -->
        <domain includeSubdomains="false">192.168.1.40</domain>
        <domain includeSubdomains="false">192.168.1.48</domain>
        <domain includeSubdomains="false">192.168.0.194</domain>
        <domain includeSubdomains="false">192.168.0.107</domain>
        <domain includeSubdomains="false">192.168.2.161</domain>
        <domain includeSubdomains="false">192.168.2.166</domain>
        <domain includeSubdomains="false">192.168.18.104</domain>
        <domain includeSubdomains="false">192.168.0.202</domain>
        <domain includeSubdomains="false">10.10.10.72</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
